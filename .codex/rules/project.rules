prefix_rule(pattern=["npm", "run", "check"], decision="allow", justification="Local dev: npm run check")
prefix_rule(pattern=["npm", "run", "typecheck"], decision="allow", justification="Local dev: npm run typecheck")
prefix_rule(pattern=["npm", "run", "lint"], decision="allow", justification="Local dev: npm run lint")
prefix_rule(pattern=["npm", "run", "test"], decision="allow", justification="Local dev: npm run test")
prefix_rule(pattern=["npm", "run", "build"], decision="allow", justification="Local dev: npm run build")
prefix_rule(pattern=["npm", "run", "format"], decision="allow", justification="Local dev: npm run format")
prefix_rule(pattern=["npm", "run", "dev"], decision="allow", justification="Local dev: npm run dev")
prefix_rule(pattern=["npm", "run", "test:e2e"], decision="allow", justification="Local dev: npm run test:e2e")
prefix_rule(pattern=["npx", "vitest"], decision="allow", justification="Local dev: npx vitest")
prefix_rule(pattern=["npx", "playwright", "test"], decision="allow", justification="Local dev: npx playwright test")
prefix_rule(pattern=["npx", "tsc", "--noEmit"], decision="allow", justification="Local dev: npx tsc --noEmit")
prefix_rule(pattern=["npx", "eslint"], decision="allow", justification="Local dev: npx eslint")
prefix_rule(pattern=["npx", "prettier"], decision="allow", justification="Local dev: npx prettier")
